# Employee Voice — environment template. Copy to .env and adjust.
# Never commit real secrets. .env is gitignored; this .example file is not.

# ── Frontend (Phases 0–5 run entirely on mock data) ──────────────────────────
# Data source toggle. true = in-memory mock provider, false = real API (Phase 9).
NEXT_PUBLIC_USE_MOCK=true

# Base URL of the Go backend. Unused while NEXT_PUBLIC_USE_MOCK=true.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# ── Backend / worker (added from Phase 6 onward; server-side only) ───────────
# The AI API key MUST stay server-side — never prefix it with NEXT_PUBLIC_.
# DATABASE_URL=postgres://user:pass@localhost:5432/employee_voice
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# ANTHROPIC_API_KEY=
# S3_ENDPOINT=
# S3_BUCKET=
# MIN_GROUP=5
